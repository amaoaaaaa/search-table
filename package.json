{
    "name": "@amaoaaaaa/search-table",
    "version": "0.1.0-beta.1",
    "type": "module",
    "description": "基于 Element Plus 的搜索表格组件，支持分页、排序、筛选、跨页勾选等功能",
    "license": "MIT",
    "author": "amaoaaaaa",
    "keywords": [
        "vue3",
        "element-plus",
        "table",
        "search",
        "pagination",
        "component"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/search-table.js",
    "module": "./dist/search-table.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/search-table.js",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/style.css"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "dev": "vite",
        "lint:tsc": "vue-tsc -b",
        "lint:eslint": "eslint .",
        "lint:prettier": "prettier --check .",
        "lint": "npm run lint:tsc && npm run lint:eslint && npm run lint:prettier",
        "format": "prettier --write .",
        "build": "vite build",
        "build:demo": "vite build --mode demo",
        "preview:demo": "vite preview --outDir demo-dist",
        "prepublishOnly": "npm run build && nrm use npm && npm login",
        "publish!": "npm publish --access public",
        "publish!:patch": "npm run prepublishOnly && npm version patch && npm run publish!",
        "publish!:minor": "npm run prepublishOnly && npm version minor && npm run publish!",
        "publish!:major": "npm run prepublishOnly && npm version major && npm run publish!",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,json,css,scss,md,html}": [
            "prettier --write"
        ]
    },
    "peerDependencies": {
        "axios": "^1.7.0",
        "element-plus": "^2.14.2",
        "lodash-es": "^4.17.21",
        "vue": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "@iconify-json/ri": "^1.2.5",
        "@iconify-json/tabler": "^1.2.26",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.7.5",
        "@typescript-eslint/eslint-plugin": "^8.61.1",
        "@typescript-eslint/parser": "^8.61.1",
        "@vitejs/plugin-vue": "^5.0.4",
        "autoprefixer": "^10.4.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^16.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "sass-embedded": "^1.100.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.5.2",
        "unplugin-auto-import": "^0.18.2",
        "unplugin-icons": "^22.2.0",
        "unplugin-vue-components": "^0.27.4",
        "vite": "^5.4.1",
        "vite-plugin-dts": "^4.0.0",
        "vue": "^3.4.31",
        "vue-eslint-parser": "^10.1.3",
        "vue-tsc": "^2.0.22"
    },
    "dependencies": {
        "@amaoaaaaa/v-text-ellipsis": "^0.2.4"
    }
}
